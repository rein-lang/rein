      "id": "f0_1",
      "kind": "done",
      "function": "ci/fix",
      "label": "Run the failed job of ${pr} again, one time. If it fails again,\nstart this program again for ${pr} with the cause test or code."
    },
    {
      "id": "f0_2",
      "kind": "done",
      "function": "ci/fix",
      "label": "askUser(question=`CI fails on ${pr} for a reason outside this pull request.\nDo I wait, or do I fix it in a new pull request?`)"
    },
    {
      "id": "f0_3",
      "kind": "request",
      "function": "ci/fix",
      "label": "request: `Read the CI log of ${pr}. Find the first failing step. Fix the test\nor the code. Push one commit.`"
    },
    {
      "id": "f0_4",
      "kind": "question",
      "function": "ci/fix",
      "label": "Did you push a fix for the failing job?\nfix_pushed: boolean",
      "name": "fix_pushed",
      "type": "boolean"
    },
    {
      "id": "f0_5",
      "kind": "done",
      "function": "ci/fix",
      "label": "Wait for CI to finish on ${pr}. Then start this program again\nwith the task merge."
    },
    {
      "id": "f0_6",
      "kind": "done",
      "function": "ci/fix",
      "label": "askUser(question=`I cannot fix the failing CI job of ${pr}. What do you want\nme to try?`)"
    },
