#!/usr/bin/env sh
set -e

cd "$(git rev-parse --show-toplevel)"

if ! command -v node >/dev/null 2>&1; then
  echo "node not found. Install Node.js from https://nodejs.org to run the example-pages check." >&2
  exit 1
fi

if ! command -v pnpm >/dev/null 2>&1; then
  echo "pnpm not found. Install it from https://pnpm.io to run the docs site build." >&2
  exit 1
fi

if ! command -v linecheck >/dev/null 2>&1; then
  echo "linecheck not found. Install it with: cargo install linecheck --version 1.2.1" >&2
  exit 1
fi

linecheck

node website/docs/scripts/generate-examples.mjs --check
sh website/docs/scripts/check-cli-drift.sh
sh scripts/check-installed-programs.sh

# The site includes pages from docs/, so a broken link between site pages
# fails the build. Links to repo files become GitHub URLs and are not checked.
# The dead-link report goes to stderr, so it stays visible.
(cd website/docs && pnpm install --frozen-lockfile --prefer-offline --silent) || {
  echo "pnpm install failed in website/docs; the docs build needs its packages." >&2
  exit 1
}
(cd website/docs && pnpm exec vitepress build >/dev/null)
