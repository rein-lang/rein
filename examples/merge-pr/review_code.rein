import securityReview from "./security/review";

/**
 * Review the code changes in a pull request.
 */
export default function reviewCode(
  /** Does the PR change authentication, payments, or permissions code? */
  securitySensitive: boolean,
) {
  if (securitySensitive) {
    return securityReview;
  }

  return "Read the diff. Leave comments for bugs and style issues. Approve when the review is clean. Then run merge_pr again.";
}
