/**
 * Fix a failing CI run, then check the pull request again.
 */
export default function fixCi(
  /** Did you push a fix for the failing job? */
  fixPushed: boolean,
) {
  if (fixPushed) {
    return @../merge_pr;
  }
  return "Read the CI log. Fix the failing test or code. Push the fix. Then run ci/fix again.";
}
