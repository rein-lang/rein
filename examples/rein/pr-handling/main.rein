/**
 * Handle one pull request, then improve this program from what the run showed.
 */
export default function main(
  /** The link of the pull request to handle. */
  pr: string,
) {
  return self_improve(
    logic=@./handle(pr=pr),
    how=`If a question was unclear, or an answer did not fit its options,
    change the program so the next run is better.`,
  );
}
