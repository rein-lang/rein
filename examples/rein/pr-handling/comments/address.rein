/**
 * Answer the open review comments on a pull request.
 */
export default async function addressComments(
  /** The link of the pull request with the review comments. */
  pr: string,
  /** Does the pull request have a review comment with no answer? */
  openComments: boolean,
) {
  if (!openComments) {
    return `No comment is open on ${pr}. Ask the reviewer for a new review. Then stop.`;
  }
  /** Did you answer every open comment with a fix or a reply? */
  const allAnswered: boolean = await request(
    `For each open comment on ${pr}: fix the code or reply with the reason you do not. Push one commit. Resolve each thread you fixed.`,
  );
  if (allAnswered) {
    return `Ask the reviewer for a new review of ${pr}. Then stop.`;
  }
  return askUser(`I cannot answer one or more review comments on ${pr}. Which change do you want?`);
}
