/**
 * Review the code changes of a pull request and post the result.
 */
export default async function review(
  /** The link of the pull request to review. */
  pr: string,
  /** Did you write this pull request yourself? */
  ownPr: boolean,
  /** Does the PR change authentication, payments, or permissions code? */
  securitySensitive: boolean,
) {
  if (ownPr) {
    return askUser(`This is my own pull request ${pr}. Who reviews it?`);
  }
  if (securitySensitive) {
    /** Did the security review find a problem that must be fixed? */
    const securityProblem: boolean = await request(
      delegate("use opus model", `review the pull request ${pr} with a security focus and list each problem with file and line`),
    );
    if (securityProblem) {
      return @./templates/post_review("request changes", "each security problem, with its file and line", pr);
    }
    return @./templates/post_review("approve", "the security checks you made", pr);
  }
  /** What is the result of the code review? */
  const verdict: "clean" | "small problems" | "blocking problems" = await request(
    delegate("use haiku model", `review the pull request ${pr} and list each problem with file and line`),
  );
  switch (verdict) {
    case "clean":
      return @./templates/post_review("approve", "one line on what you checked", pr);
    case "small problems":
      return @./templates/post_review("comment", "each small problem, with its file and line", pr);
    case "blocking problems":
      return @./templates/post_review("request changes", "each blocking problem, with its file and line", pr);
  }
}
