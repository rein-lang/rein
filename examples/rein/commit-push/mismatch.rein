interface Input {
  /** Can you start a subagent with a chosen model and effort? */
  can_spawn: boolean;
  /** The model to run on. */
  model: string;
  /** The effort to run with. */
  effort: string;
  /** The call that starts the program again. */
  start: string;
}

/**
 * Tell the agent how to run commit-push on the right model and effort.
 */
export default function mismatch(
  { can_spawn, model, effort, start }: Input,
) {
  if (can_spawn) {
    return `Start a subagent on ${model} with effort ${effort}.
Give it this task: ${start}`;
  }

  return askUser(
    question=`Open a new session on ${model} with effort ${effort}.
Then run: ${start}`,
  );
}
