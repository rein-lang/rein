description "Decide how the on-call agent handles a new production alert."

input severity: choice("sev1", "sev2", "sev3") "How severe is the alert?"
input customer_impact: bool "Are customers seeing errors or downtime right now?"
input known_runbook: bool "Does a runbook exist for this alert?"

if customer_impact {
    return @page_human
}

switch severity {
    case "sev1" {
        return @page_human
    }
    default {
        if known_runbook {
            return @runbook/follow
        }
        return @ticket/open
    }
}
