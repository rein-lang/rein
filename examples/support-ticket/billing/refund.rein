import escalate from "../escalate";

/**
 * Process a refund request from a billing ticket.
 */
export default function refund(
  /** Is the requested refund above the agent's limit? */
  refundOverLimit: boolean,
) {
  if (refundOverLimit) {
    return escalate;
  }

  return "Refund the amount the customer asked for. Confirm the refund in the ticket. Tell the customer the refund takes 5 business days.";
}
